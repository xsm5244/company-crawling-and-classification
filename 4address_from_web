    output_csv = "/Users/mac/Desktop/tongbu/企业科研/yiji2026jiangsu/2cid对应数据/company_real_addresses.csv"

    scraper = CompanyAddressScraper(headless=True)
    scraper.scrape_from_csv(input_csv, output_csv)
